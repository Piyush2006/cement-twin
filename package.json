{
  "name": "cement-plant-twin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 7373 --host",
    "build": "vite build",
    "preview": "vite preview --port 7373 --host",
    "model": "npm run model:salvage && npm run model:prepare",
    "model:salvage": "python3 tools/salvage_glb.py \"$npm_config_src\" build/plant-salvaged.glb",
    "model:prepare": "node tools/prepare-model.mjs build/plant-salvaged.glb public/models/plant.glb src/data/plant-geometry.json"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "ffmpeg-static": "^5.3.0",
    "meshoptimizer": "^0.22.0",
    "playwright": "^1.49.0",
    "vite": "^5.4.21"
  }
}
